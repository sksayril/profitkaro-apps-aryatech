{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Android: Launch emulator (Pixel 9 Pro API 35)",
      "type": "shell",
      "command": "flutter",
      "args": ["emulators", "--launch", "Pixel_9_Pro_API_35"],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false
      }
    },
    {
      "label": "Flutter: Run on Android (start emulator + run)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/run-android.ps1"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      }
    }
  ]
}
